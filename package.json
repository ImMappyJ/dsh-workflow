{
  "name": "@mappyj/dsh-plugin-workflow",
  "version": "0.1.4",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "Multi-Agent Workflow plugin for DeepSeek Harness (dsh)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImMappyJ/dsh-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/ImMappyJ/dsh-workflow/issues"
  },
  "homepage": "https://github.com/ImMappyJ/dsh-workflow#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "public",
    "cordis.patch.yml",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deploy": "npm run build && cp -r lib public cordis.patch.yml package.json LICENSE ~/.dsh/plugins/dsh-plugin-workflow/",
    "postinstall": "node scripts/auto-register.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {}
}